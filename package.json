{
  "name": "darkestshades",
  "private": true,
  "sideEffects": false,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "shopify hydrogen dev",
    "build": "shopify hydrogen build",
    "build:review": "DS_REVIEW_BUILD=1 shopify hydrogen build",
    "preview": "shopify hydrogen preview",
    "preview:review": "DS_REVIEW_BUILD=1 shopify hydrogen preview --build",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project=app-390 --project=app-1440 --project=storybook",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build --quiet",
    "flashcheck": "python3 tools/flashcheck.py",
    "lighthouse": "node checks/lighthouse.mjs --assert",
    "check:strings": "node checks/strings.mjs",
    "check:hex": "node checks/hex.mjs",
    "check:schema": "node checks/schema.mjs",
    "check:copy-gate": "node checks/copy-gate.mjs",
    "check:layers": "node checks/layers.mjs",
    "check:copy-audit": "node checks/copy-audit.mjs",
    "checks": "npm run check:strings && npm run check:hex && npm run check:schema && npm run check:copy-gate && npm run check:copy-audit && npm run check:layers && python3 tools/flashcheck.py",
    "ci": "npm run checks && npm run typecheck && npm run lint && npm run test && npm run build:review && npm run storybook:build && npm run test:e2e",
    "capture:wire": "DS_CAPTURE=wire playwright test --project=capture",
    "capture:ui": "DS_CAPTURE=ui playwright test --project=capture"
  },
  "prettier": "@shopify/prettier-config",
  "dependencies": {
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource-variable/urbanist": "^5.3.0",
    "@shopify/hydrogen": "2026.4.7",
    "graphql": "^16.10.0",
    "isbot": "^5.1.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.16.0",
    "react-router-dom": "7.16.0",
    "tailwindcss": "^4.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "7.16.0",
    "@react-router/fs-routes": "7.16.0",
    "@shopify/cli": "3.93.2",
    "@shopify/mini-oxygen": "4.2.3",
    "@shopify/oxygen-workers-types": "^4.1.6",
    "@shopify/prettier-config": "^1.1.2",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.1.6",
    "@testing-library/react": "^16.3.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-storybook": "^10.6.5",
    "globals": "^15.14.0",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.6.0",
    "playwright": "^1.63.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.4.2",
    "storybook": "^10.6.5",
    "typescript": "^5.9.2",
    "vite": "^8.0.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "browserslist": [
    "defaults"
  ]
}
