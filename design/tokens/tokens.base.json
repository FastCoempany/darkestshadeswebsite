{
 "$description": "Darkest Shades non-color tokens. Type uses only Owners Wide and Stolzl; until they're licensed, open-licensed stand-ins render them (brand/fonts/README.md). Sizes are fluid between 390px and 1440px viewports.",
 "font": {
  "family": {
   "display": {
    "$type": "fontFamily",
    "$value": "'Owners Wide', 'owners-wide', 'Mona Sans Variable', ui-sans-serif, system-ui, sans-serif",
    "$description": "Owners Wide Medium. Display and headings only, uppercase by style. Stand-in until licensed: Mona Sans, tuned by font.variation.display."
   },
   "text": {
    "$type": "fontFamily",
    "$value": "'Stolzl', 'stolzl', 'Urbanist Variable', ui-sans-serif, system-ui, sans-serif",
    "$description": "Stolzl Light/Book/Regular/Medium. Body, UI, labels. Stand-in until licensed: Urbanist, whose weights line up with Stolzl's."
   }
  },
  "variation": {
   "display": {
    "$type": "string",
    "$value": "\"wdth\" 125, \"wght\" 640",
    "$description": "Display text only. Sets the stand-in Mona Sans to its widest and to Owners Wide Medium's visual weight. Static Owners Wide files ignore it, so it can stay when the real font arrives."
   }
  },
  "weight": {
   "light": {
    "$type": "fontWeight",
    "$value": 300,
    "$description": "Stolzl Light: 22px and up only."
   },
   "book": {
    "$type": "fontWeight",
    "$value": 350,
    "$description": "Stolzl Book: body. The local @font-face maps Book to 350; check an Adobe Fonts kit's weights before relying on it."
   },
   "regular": {
    "$type": "fontWeight",
    "$value": 400,
    "$description": "Stolzl Regular: UI, cards."
   },
   "medium": {
    "$type": "fontWeight",
    "$value": 500,
    "$description": "Stolzl Medium: buttons, micro labels. Owners Wide Medium: display."
   }
  },
  "size": {
   "manifesto": {
    "$type": "dimension",
    "$value": "clamp(2.5rem, 0.643rem + 7.619vw, 7.5rem)",
    "$description": "40 -> 120px. Line height 0.95."
   },
   "display": {
    "$type": "dimension",
    "$value": "clamp(2rem, 1.071rem + 3.810vw, 4.5rem)",
    "$description": "32 -> 72px."
   },
   "h1": {
    "$type": "dimension",
    "$value": "clamp(1.75rem, 1.379rem + 1.524vw, 2.75rem)",
    "$description": "28 -> 44px."
   },
   "h2": {
    "$type": "dimension",
    "$value": "clamp(1.375rem, 1.189rem + 0.762vw, 1.875rem)",
    "$description": "22 -> 30px."
   },
   "label": {
    "$type": "dimension",
    "$value": "clamp(0.8125rem, 0.766rem + 0.190vw, 0.9375rem)",
    "$description": "13 -> 15px, Owners Wide Medium uppercase."
   },
   "body-lg": {
    "$type": "dimension",
    "$value": "1.125rem"
   },
   "body": {
    "$type": "dimension",
    "$value": "1rem"
   },
   "ui": {
    "$type": "dimension",
    "$value": "0.9375rem"
   },
   "small": {
    "$type": "dimension",
    "$value": "0.875rem"
   },
   "micro": {
    "$type": "dimension",
    "$value": "0.75rem",
    "$description": "Uppercase Stolzl Medium: drop status, look numbers, spec labels."
   },
   "card": {
    "$type": "dimension",
    "$value": "clamp(0.9375rem, 0.891rem + 0.190vw, 1.0625rem)",
    "$description": "The strobe's small centered sentence."
   }
  },
  "leading": {
   "manifesto": {
    "$type": "number",
    "$value": 0.95
   },
   "display": {
    "$type": "number",
    "$value": 1.0
   },
   "heading": {
