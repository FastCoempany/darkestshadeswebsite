{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkestshades.com/wall/assets/manifest.schema.json",
  "title": "The drawer wall's asset manifest",
  "description": "Every committed web asset of the wall, with the tool and command that made it, its source commit, its status and its checks (DRAWER-WALL.md, Assets). npm run check fails on any entry without its file, any file without its entry, and any file over its budget.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "renderSet",
    "assets"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "renderSet": {
      "type": "string",
      "description": "The asset set the wall was rendered as (bay_wall.render_set)."
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "files",
          "status",
          "tool",
          "command",
          "sourceCommit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9/._-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "wall-plate",
              "wall-dark",
              "sequence-frame",
              "glb",
              "still",
              "env",
              "camera",
              "rects",
              "tints"
            ]
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "prototype",
              "mockup",
              "final"
            ]
          },
          "tool": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "sourceCommit": {
            "type": "string",
            "description": "HEAD when the file was exported, with -dirty when the tools or the exporter had uncommitted changes then",
            "pattern": "^[0-9a-f]{7,40}(-dirty)?$"
          },
          "toolsHash": {
            "type": "string",
            "description": "a stamp of the tool files the entry was made with (render_queue.tools_hash)",
            "pattern": "^[0-9a-f]{12}$"
          },
          "frame": {
            "type": "string",
            "pattern": "^F0[1-9]$"
          },
          "layout": {
            "type": "string",
            "enum": [
              "portrait",
              "landscape"
            ]
          },
          "knob": {
            "type": "string",
            "enum": [
              "black-relief",
              "gold",
              "plain"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "alt": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
