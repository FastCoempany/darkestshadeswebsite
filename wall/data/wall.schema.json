{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkestshades.com/wall/data/wall.schema.json",
  "title": "The drawer wall's records",
  "description": "Two kinds of record shaped like Shopify metaobjects (DRAWER-WALL.md, Every drawer is its own thing): one bay_wall (handle `frames`) whose `bays` field lists the drawer_bay records in wall order, and one drawer_bay per drawer. Until a store holds them they live here and are read through wall/src/data/adapter.ts. A field's `value` is a string as Shopify stores it (null when unset); a list field's value is a JSON array in that string; `reference` may carry a resolved reference and is ignored. Each record carries each of its keys exactly once. The ids a `bays` list names must exist: checks/schema.mjs verifies that after validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "records"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/bayWall"
          },
          {
            "$ref": "#/$defs/drawerBay"
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(bay_wall|drawer_bay)/[a-z0-9-]+$",
      "description": "A stable id: `type/handle` here, a gid in Shopify."
    },
    "handle": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "bayWall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "handle",
        "type",
        "fields"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "handle": {
          "$ref": "#/$defs/handle"
        },
        "type": {
          "const": "bay_wall"
        },
        "fields": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/bays"
              },
              {
                "$ref": "#/$defs/knobStyle"
              },
              {
                "$ref": "#/$defs/renderSet"
              }
            ]
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "key": {
                    "const": "bays"
                  }
                },
                "required": [
                  "key"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "key": {
                    "const": "knob_style"
                  }
                },
                "required": [
                  "key"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "key": {
                    "const": "render_set"
                  }
                },
                "required": [
                  "key"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        }
      }
    },
    "bays": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "value"
      ],
      "properties": {
        "key": {
          "const": "bays"
        },
        "type": {
          "const": "list.metaobject_reference"
        },
        "value": {
          "type": "string",
          "pattern": "^\\[\\s*(\"drawer_bay/[a-z0-9-]+\"(\\s*,\\s*\"drawer_bay/[a-z0-9-]+\")*)?\\s*\\]$",
          "description": "A JSON array of drawer_bay ids, in wall order."
        },
        "reference": {
          "description": "A resolved reference, as the Storefront API returns one; ignored here (ids are resolved through the records list)."
        }
      }
    },
    "knobStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "value"
      ],
      "properties": {
        "key": {
          "const": "knob_style"
        },
        "type": {
          "const": "single_line_text_field"
        },
        "value": {
          "type": "string",
          "enum": [
            "black-relief",
            "gold",
            "plain"
          ]
        },
        "reference": {
          "description": "A resolved reference, as the Storefront API returns one; ignored here (ids are resolved through the records list)."
        }
      }
    },
    "renderSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "value"
      ],
      "properties": {
        "key": {
          "const": "render_set"
        },
        "type": {
          "const": "single_line_text_field"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "reference": {
          "description": "A resolved reference, as the Storefront API returns one; ignored here (ids are resolved through the records list)."
        }
      }
    },
    "drawerBay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "handle",
        "type",
        "fields"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "handle": {
          "$ref": "#/$defs/handle"
        },
        "type": {
          "const": "drawer_bay"
        },
        "fields": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/frame"
              },
              {
                "$ref": "#/$defs/state"
              },
              {
                "$ref": "#/$defs/light"
              },
              {
                "$ref": "#/$defs/note"
              }
            ]
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "key": {
                    "const": "frame"
                  }
                },
                "required": [
                  "key"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "key": {
                    "const": "state"
                  }
                },
                "required": [
                  "key"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "key": {
                    "const": "light"
                  }
                },
                "required": [
                  "key"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "key": {
                    "const": "note"
                  }
                },
                "required": [
                  "key"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            }
          ]
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "value"
      ],
      "properties": {
        "key": {
          "const": "frame"
        },
        "type": {
          "const": "single_line_text_field"
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "description": "A frame id (F09); later a product reference. Its facts come from content/products/."
        },
        "reference": {
          "description": "A resolved reference, as the Storefront API returns one; ignored here (ids are resolved through the records list)."
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "value"
      ],
      "properties": {
        "key": {
          "const": "state"
        },
        "type": {
          "const": "single_line_text_field"
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "available",
            "sold_out",
            "locked",
            "hidden",
            null
          ]
        },
        "reference": {
          "description": "A resolved reference, as the Storefront API returns one; ignored here (ids are resolved through the records list)."
        }
      }
    },
    "light": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "value"
      ],
      "properties": {
        "key": {
          "const": "light"
        },
        "type": {
          "const": "single_line_text_field"
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "auto",
            "lit",
            "dark",
            null
          ]
        },
        "reference": {
          "description": "A resolved reference, as the Storefront API returns one; ignored here (ids are resolved through the records list)."
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "value"
      ],
      "properties": {
        "key": {
          "const": "note"
        },
        "type": {
          "const": "multi_line_text_field"
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "description": "Internal; never rendered."
        },
        "reference": {
          "description": "A resolved reference, as the Storefront API returns one; ignored here (ids are resolved through the records list)."
        }
      }
    }
  }
}
