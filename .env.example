# Copy to .env for local runs. Nothing here is required in this phase: the site runs on local mock data
# (app/lib/mock/) and makes no Shopify calls.

# Review builds carry production settings but allow draft and placeholder copy (docs/build/RUN.md).
# `npm run build:review` and `npm run preview:review` set this themselves.
# DS_REVIEW_BUILD=1

# Fonts, route A (brand/fonts/README.md): an Adobe Fonts web project ID. Unset = the open-licensed stand-ins.
# PUBLIC_ADOBE_FONTS_KIT=

# The pairs-left threshold: above this many pairs the count is hidden. Unset = no threshold (the founder decides).
# PUBLIC_PAIRS_LEFT_THRESHOLD=

# Reserved for launch (never set in this phase; the app must not call Shopify until then):
# SESSION_SECRET=
# PUBLIC_STORE_DOMAIN=
# PUBLIC_STOREFRONT_API_TOKEN=
# PUBLIC_STOREFRONT_ID=
# PUBLIC_CHECKOUT_DOMAIN=
# PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
# PUBLIC_CUSTOMER_ACCOUNT_API_URL=
